#!/bin/sh
# Block commits that contain Frontier tokens or .env files.
# Enable once per clone: git config core.hooksPath .githooks
set -u
fail=0

# 1. Never commit .env files (.env.example is allowed).
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
  case "$f" in
    .env.example|*/.env.example) ;;
    .env|.env.*|*/.env|*/.env.*)
      echo "pre-commit: refusing to commit $f (secrets file)."
      fail=1 ;;
  esac
done

added=$(git diff --cached -U0 --diff-filter=ACMR | grep '^+' | grep -v '^+++' || true)

# 2. No token-shaped strings (participant and team tokens look like cn-x-…).
if printf '%s\n' "$added" | grep -Eq 'cn-[a-z]-[A-Za-z0-9_]+-[A-Za-z0-9_-]{6,}'; then
  echo "pre-commit: a staged change contains a Frontier token (cn-…)."
  fail=1
fi

# 3. No API keys or credentials: OpenRouter/OpenAI/Anthropic (sk-…), GitHub, AWS,
#    private keys, and api_key/secret_key assignments (adapted from Calvino's hook).
#    The patterns are written so this file never matches itself.
keys_re='sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{36,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(api|secret)_?key[[:space:]]*[:=][[:space:]]*["'"'"'][A-Za-z0-9_-]{16,}'
if printf '%s\n' "$added" | grep -Eqi -- "$keys_re"; then
  echo "pre-commit: a staged change looks like it contains an API key or credential."
  fail=1
fi

# 4. No literal secret values copied from .env (any *TOKEN= or *KEY= variable).
if [ -f .env ]; then
  for v in $(sed -nE 's/^[A-Z_]*(TOKEN|KEY)=//p' .env); do
    [ -n "$v" ] || continue
    if printf '%s\n' "$added" | grep -qF -- "$v"; then
      echo "pre-commit: a staged change contains a secret value from .env."
      fail=1
    fi
  done
fi

if [ "$fail" -ne 0 ]; then
  echo "Commit blocked. Remove the secret, then commit again."
  exit 1
fi
exit 0
